# Predictable checkout even when Windows uses core.autocrlf=true.
* text=auto eol=lf

gradlew text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.ppt binary
*.pptx binary
*.hwpx binary
*.woff binary
*.woff2 binary
